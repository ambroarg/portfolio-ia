QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=portfolio_data
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
EMBEDDING_MODEL=bge-m3

# Dimension des vecteurs du modele d'embedding (bge-m3 = 1024)
EMBEDDING_DIM=1024
# Nombre de chunks remontes par recherche
TOP_K=4
# Score cosinus minimal d'un passage. En dessous, la question est consideree
# hors sujet et repondue sans appeler le LLM. Voir config.py pour les mesures.
MIN_SCORE=0.35

# Origines autorisees par CORS, separees par des virgules. En Docker le
# frontend est servi par nginx sur la meme origine : rien a declarer. A
# remplacer par https://ton-domaine.fr lors du deploiement.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500